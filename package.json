{
  "name": "nexus-arqui-14",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare": "husky",
    "baseline": "git status --short && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check \"{AGENTS.md,README.md,CONTRIBUTING.md,ARCHITECTURE.md,DECISIONS.md,PLAN.md,NEXT.md,TASKS.md,TESTING.md,SECURITY.md,package.json,eslint.config.mjs,vitest.config.ts}\" \"docs/**/*.md\" \".github/**/*.{md,yml}\" \"src/**/*.{test,spec}.{ts,tsx}\" \"src/test/**/*.ts\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "security:check": "npm audit --audit-level=critical",
    "verify:ci": "npm run verify && npm run security:check",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "docx": "8.5.0",
    "file-saver": "2.0.5",
    "gantt-task-react": "0.3.9",
    "html2canvas": "1.4.1",
    "jspdf": "^4.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "^6.30.3",
    "recharts": "2.12.7",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.2.0",
    "vitest": "^3.2.0"
  },
  "lint-staged": {
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ],
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ]
  }
}
