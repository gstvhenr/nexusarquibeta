#!/usr/bin/env sh
set -eu

message_file="${1:-}"

if [ -z "$message_file" ] || [ ! -f "$message_file" ]; then
  echo "husky(commit-msg): arquivo de mensagem nao encontrado."
  exit 1
fi

first_line="$(sed -n '1p' "$message_file" | tr -d '\r')"

case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *)
    exit 0
    ;;
esac

if printf '%s\n' "$first_line" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+$'; then
  exit 0
fi

echo "Mensagem de commit invalida."
echo "Padrao esperado: tipo(escopo opcional): descricao"
echo "Exemplo: feat(relatorios): adiciona filtro por periodo"
echo "Tipos validos: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
exit 1
